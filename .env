# --- Site ---
# URL publique du site, utilisée dans le lien envoyé pour la réinitialisation
# du mot de passe. Laisser vide en local (l'origine du navigateur est utilisée
# automatiquement) ; renseigner en production, ex: https://www.bestberry.cm
VITE_SITE_URL=https://www.best-berry.vercel.app

# --- Appwrite ---
VITE_APPWRITE_DATABASE_ID=best_berry_db
APPWRITE_PROJECT_ID=6ac0f8e7000535abb9f0
APPWRITE_PROJECT_NAME=Best-berry
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1

# Collections (create these exact IDs in Appwrite, see SETUP.md)
VITE_APPWRITE_COL_PAGES=pages_contenu
VITE_APPWRITE_COL_ACTUALITES=actualites
VITE_APPWRITE_COL_EVENEMENTS=evenements
VITE_APPWRITE_COL_STAFF=staff
VITE_APPWRITE_COL_GALERIE=galerie
VITE_APPWRITE_COL_INSCRIPTIONS=inscriptions

# Storage buckets
VITE_APPWRITE_BUCKET_MEDIA=media_images
VITE_APPWRITE_BUCKET_PIECES=pieces_inscription

# --- Cloudinary (photos du site, actualités, galerie) ---
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# --- Contact / footer ---
VITE_SCHOOL_PHONE=+237 6XX XXX XXX
VITE_SCHOOL_EMAIL=contact@bestberry.cm
