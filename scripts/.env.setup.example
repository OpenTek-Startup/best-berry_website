# Identifiants pour le script scripts/setup-appwrite.mjs UNIQUEMENT.
# Ce fichier (une fois copié en .env.setup) ne doit JAMAIS être commité ni
# utilisé dans le frontend : APPWRITE_API_KEY donne des droits d'administration
# complets sur le projet Appwrite.

# Même valeur que VITE_APPWRITE_ENDPOINT dans le .env du site
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Même valeur que VITE_APPWRITE_PROJECT_ID dans le .env du site
APPWRITE_PROJECT_ID=

# Console Appwrite -> Settings -> API Keys -> Create API Key
# Scopes nécessaires : databases.read, databases.write, collections.read,
# collections.write, attributes.read, attributes.write, documents.read,
# teams.read, teams.write, buckets.read, buckets.write
APPWRITE_API_KEY=
